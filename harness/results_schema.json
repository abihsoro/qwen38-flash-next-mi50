{
  "schema_version": 2,
  "description": "Results row schema v2 (D048 amendment): steps_per_second is the acceptance metric; tokens_per_second recorded, never governing. v1 rows (schema_version 1) stay readable but are inadmissible for acceptance (I5/D048).",
  "properties": {
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "git_commit": {"type": "string"},
    "dirty_flag": {"type": "boolean"},
    "rocm_version": {"type": "string"},
    "torch_version": {"type": "string"},
    "triton_commit": {"type": "string"},
    "vllm_commit": {"type": "string"},
    "kernel_version": {"type": "string"},
    "gfx_target": {"type": "string", "const": "gfx906:xnack-"},
    "guest_kernel": {"type": "string"},
    "pve_version": {"type": "string"},
    "gpu_count": {"type": "integer"},
    "tp": {"type": ["integer", "null"]},
    "ep": {"type": ["integer", "null"]},
    "mtp": {"type": ["integer", "null"]},
    "power_cap_w": {"type": ["number", "null"]},
    "observed_power_w": {"type": ["number", "null"]},
    "gpu_clock_mhz": {"type": ["number", "null"]},
    "hbm_clock_mhz": {"type": ["number", "null"]},
    "temp_c": {"type": ["number", "null"]},
    "soak_seconds": {"type": ["number", "null"]},
    "context": {"type": ["string", "null"]},
    "gen_tokens": {"type": ["integer", "null"]},
    "repeat_index": {"type": ["integer", "null"]},
    "tokens_per_second": {"type": ["number", "null"]},
    "prefill_tps": {"type": ["number", "null"]},
    "ttft_ms": {"type": ["number", "null"]},
    "kernel_config": {"type": ["string", "null"]},
    "correctness_hash": {"type": ["string", "null"]},
    "exit_code": {"type": "integer"},
    "wall_seconds": {"type": "number"},
    "timeout_s": {"type": "number"},
    "notes": {"type": ["string", "null"]},
    "schema_version": {"type": "integer", "const": 2},
    "steps_per_second": {"type": ["number", "null"]},
    "accepted_tokens_per_step": {"type": ["number", "null"]},
    "forward_steps": {"type": ["integer", "null"]},
    "decode_wall_seconds": {"type": ["number", "null"]},
    "shape_profile": {"type": ["string", "null"], "enum": ["full", "tp4_rank0", "microbench"]},
    "graphs": {"type": ["string", "null"], "enum": ["off", "piecewise", "full"]},
    "dtype": {"type": ["string", "null"], "enum": ["float16", "bfloat16", "float32"]},
    "ple_source": {"type": ["string", "null"], "enum": ["none", "bf16_table", "int4_sidecar"]},
    "ple_offload": {"type": ["boolean", "null"]},
    "thermally_valid": {"type": ["boolean", "null"]},
    "clock_deviation_pct": {"type": ["number", "null"]},
    "timed_out": {"type": ["boolean", "null"]},
    "tp4_projection_factor": {"type": ["number", "null"]}
  },
  "required": [
    "run_id", "task_id", "git_commit", "dirty_flag", "exit_code",
    "wall_seconds", "timeout_s", "notes", "schema_version"
  ]
}
